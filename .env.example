# Banco (docker compose expõe o Postgres em 55432 para não colidir com instalação local)
DATABASE_URL="postgresql://editor:editor@localhost:55432/editor_video?schema=public"

# Fila (docker compose expõe o Redis em 46379)
REDIS_URL="redis://localhost:46379"

# Storage local. Trocar por driver S3/R2 na fase 2 (ver packages/core/src/storage.ts)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"

# Limites de upload
MAX_CLIP_SIZE_MB=100
MAX_CLIP_DURATION_SEC=60
MAX_CLIPS_PER_PROJECT=10
MIN_CLIPS_PER_PROJECT=3

# Render
RENDER_CONCURRENCY=1
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30

# Legendas (Gemini por padrão; usa GEMINI_API_KEY). whisper = whisper.cpp local.
CAPTIONS_PROVIDER=gemini
CAPTIONS_LANGUAGE=pt
# Opcional — vazio herda GEMINI_MODEL. Precisa ser um modelo que aceite áudio.
GEMINI_CAPTIONS_MODEL=
# Modelos tentados em sequência quando o principal estoura a cota diária (429).
# Vazio herda GEMINI_MODEL_FALLBACKS (ver abaixo). Lista separada por vírgula.
GEMINI_CAPTIONS_MODEL_FALLBACKS=

# Whisper.cpp (só se CAPTIONS_PROVIDER=whisper, ou como fallback se o Gemini falhar)
WHISPER_ENABLED=true
WHISPER_BIN=whisper-cli
# Caminho absoluto ou relativo à raiz do monorepo, ex.: ./models/ggml-base.bin
WHISPER_MODEL=

# V2 Curiosidade — roteiro e narração via Gemini (GEMINI_API_KEY abaixo)
# Stock media (pelo menos uma chave)
PEXELS_API_KEY=
PIXABAY_API_KEY=

# TTS local (Piper)
PIPER_BIN=piper
PIPER_MODEL=
# >1 = fala mais devagar; segundos de silêncio entre frases (pausas mais naturais)
PIPER_LENGTH_SCALE=1.15
PIPER_SENTENCE_SILENCE=0.5

# Voice Director — narração via Gemini TTS (usa GEMINI_API_KEY abaixo)
ENABLE_VOICE_DIRECTION=true
TTS_PROVIDER=gemini
GEMINI_TTS_VOICE=Orus
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# Modelos TTS alternativos tentados em sequência em caso de 429 (cota diária própria por modelo).
GEMINI_TTS_MODEL_FALLBACKS=gemini-3.1-flash-tts-preview,gemini-2.5-pro-preview-tts

# Duração alvo do vídeo Curiosidade
CURIOSIDADE_MIN_DURATION_SEC=25
CURIOSIDADE_MAX_DURATION_SEC=50
CURIOSIDADE_VISUAL_QUERIES=6

# Ambient / sons relaxantes
AMBIENT_DEFAULT_DURATION_MIN=60
AMBIENT_DEFAULT_PURPOSE=sleep
AMBIENT_QUALITY_THRESHOLD=75
AMBIENT_MAX_RETRIES=2
AMBIENT_PREVIEW_DURATION_SEC=60
AMBIENT_AUTO_CONCEPT=false
AMBIENT_AUTO_SEARCH=true
AMBIENT_AUTO_PUBLISH=false
AMBIENT_VIDEO_WIDTH=1920
AMBIENT_VIDEO_HEIGHT=1080
AMBIENT_VIDEO_FPS=30
AMBIENT_MAX_DURATION_MIN=600
AMBIENT_MAX_DOWNLOAD_MB=500
AMBIENT_SLEEP_MIN_DURATION_MIN=60
AMBIENT_SLEEP_MAX_DURATION_MIN=600
AMBIENT_COZY_FOCUS_MAX_DURATION_MIN=180
FREESOUND_API_KEY=

# Canal Cristão (Gemini + regras de repetição)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Modelos tentados em sequência quando o principal estoura a cota diária (429).
# Também herdado por RABISCO_GEMINI_MODEL_FALLBACKS e GEMINI_CAPTIONS_MODEL_FALLBACKS
# quando esses estiverem vazios. Lista separada por vírgula.
GEMINI_MODEL_FALLBACKS=gemini-3.1-flash-lite,gemini-3.6-flash,gemini-3.7-flash,gemini-3.8-flash,gemini-3-flash
VERSE_REUSE_DAYS=180
THEME_REUSE_DAYS=14
CHRISTIAN_MIN_DURATION_SEC=30
CHRISTIAN_MAX_DURATION_SEC=60
CHRISTIAN_VISUAL_QUERIES=3
# userId usado por scripts de automação (generate:daily) sem sessão HTTP
CHRISTIAN_AUTOMATION_USER_ID=
# Handle do canal (ex.: @minutodefe56) — usado como watermark padrão
CHRISTIAN_YOUTUBE_HANDLE=

# Auth.js (obrigatório em produção — gere com: openssl rand -base64 32)
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
# true = exige login; padrão: acesso aberto com o usuário local
AUTH_REQUIRED=false

# YouTube Data API (OAuth do canal Midnight)
# Crie um OAuth Client no Google Cloud Console com redirect:
#   http://localhost:3000/api/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/youtube/callback

# ===================== V3 — Hub de canais (docs/especificacao-v3-hub-editor-ia.md) =====================
# Agente incorporado (apps/agent, Claude Agent SDK). Credencial PRÓPRIA do produto:
# a assinatura pessoal do Claude Code não cobre o uso incorporado.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5
AGENT_EFFORT=high
AGENT_PORT=4100
AGENT_SERVICE_URL=http://127.0.0.1:4100
# Segredo compartilhado web ↔ agente (mín. 16 caracteres): openssl rand -hex 24
AGENT_SERVICE_TOKEN=
# Tokens sociais cifrados em repouso (AES-256-GCM, 32 bytes base64): openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=
# Transcrição V3: whisper.cpp (usa WHISPER_BIN/WHISPER_MODEL acima) ou faster-whisper
TRANSCRIPTION_PROVIDER=whisper.cpp
PYTHON_BIN=python
FASTER_WHISPER_MODEL=small
# Limites de upload (bytes) e espaço livre mínimo
MAX_UPLOAD_BYTES=21474836480
MIN_FREE_DISK_BYTES=5368709120
# render-worker: filas desta máquina e concorrência
V3_QUEUES=v3-analysis,v3-preview,v3-render-short,v3-render-long
V3_ANALYSIS_CONCURRENCY=2
V3_PREVIEW_CONCURRENCY=2
V3_RENDER_CONCURRENCY=1
V3_LONG_RENDER_CONCURRENCY=1
# FFMPEG_PATH= / FFPROBE_PATH= (opcional; padrão: PATH)
