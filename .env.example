# Banco (docker compose expõe o Postgres em 55432 para não colidir com instalação local)
DATABASE_URL="postgresql://editor:editor@localhost:55432/editor_video?schema=public"

# Fila (docker compose expõe o Redis em 56379)
REDIS_URL="redis://localhost:56379"

# Storage local. Trocar por driver S3/R2 na fase 2 (ver packages/core/src/storage.ts)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"

# Limites de upload
MAX_CLIP_SIZE_MB=100
MAX_CLIP_DURATION_SEC=60
MAX_CLIPS_PER_PROJECT=10
MIN_CLIPS_PER_PROJECT=3

# Render
RENDER_CONCURRENCY=1
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30

# Whisper / legendas (whisper.cpp). Necessário só se algum clipe tiver "Legendas automáticas".
WHISPER_ENABLED=true
WHISPER_BIN=whisper-cli
# Caminho absoluto ou relativo à raiz do monorepo, ex.: ./models/ggml-base.bin
WHISPER_MODEL=
WHISPER_LANGUAGE=pt

# V2 Curiosidade — Ollama (LLM local)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Stock media (pelo menos uma chave)
PEXELS_API_KEY=
PIXABAY_API_KEY=

# TTS local (Piper)
PIPER_BIN=piper
PIPER_MODEL=

# Duração alvo do vídeo Curiosidade
CURIOSIDADE_MIN_DURATION_SEC=25
CURIOSIDADE_MAX_DURATION_SEC=50
CURIOSIDADE_VISUAL_QUERIES=6

# Ambient / sons relaxantes
AMBIENT_DEFAULT_DURATION_MIN=60
AMBIENT_DEFAULT_PURPOSE=sleep
AMBIENT_QUALITY_THRESHOLD=75
AMBIENT_MAX_RETRIES=2
AMBIENT_PREVIEW_DURATION_SEC=60
AMBIENT_AUTO_CONCEPT=false
AMBIENT_AUTO_SEARCH=true
AMBIENT_AUTO_PUBLISH=false
AMBIENT_VIDEO_WIDTH=1920
AMBIENT_VIDEO_HEIGHT=1080
AMBIENT_VIDEO_FPS=30
FREESOUND_API_KEY=
