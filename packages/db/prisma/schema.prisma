generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectKind {
  TOP_LIST
  CURIOSIDADE
  AMBIENT
  CHRISTIAN
  RABISCO
}

enum ProjectStatus {
  DRAFT
  QUEUED
  PROCESSING
  WAITING_PREVIEW_APPROVAL
  READY
  READY_FOR_REVIEW
  PUBLISHED
  FAILED
}

enum LicenseVerdict {
  SAFE
  ATTRIBUTION_REQUIRED
  UNKNOWN
  REJECTED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  projects        Project[]
  youtubeChannel  YouTubeChannel?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id        String        @id @default(cuid())
  title     String
  watermark String?
  status    ProjectStatus @default(DRAFT)
  kind      ProjectKind   @default(TOP_LIST)

  /// Estilo visual das legendas: minimal | highlight | handwritten (docs/Cristão/projeto.md)
  captionStyle String? @default("minimal")

  /// Dono do projeto (nullable só para backfill de dados legados)
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Tema informado pelo usuário (pipeline Curiosidade)
  topic String?
  /// Roteiro gerado pelo LLM (JSON)
  scriptJson Json?
  /// Key do WAV de narração no storage
  voiceoverKey String?

  /// --- Canal Cristão ---
  /// Pilar de conteúdo selecionado (ex: "verse_of_day", "prayer_protection")
  pillar String?
  /// Versículo bíblico usado nesta peça (biblioteca local, nunca gerado por LLM)
  verseId String?
  bibleVerse BibleVerse? @relation(fields: [verseId], references: [id], onDelete: SetNull)
  /// Resultado do safety checker (regras de saúde/editoriais)
  safetyJson Json?
  /// Estado visual do personagem (colorLevel/lightLevel/detailLevel/emotion/pose)
  characterStateJson Json?
  /// Roteiro segmentado pelo Voice Director (emoção/ritmo/pausa por trecho) + provider usado
  voiceScriptJson Json?
  /// Horário-alvo de publicação (geração em lote) — quando setado, o worker
  /// publica automaticamente no YouTube (agendado) assim que o render terminar.
  scheduledAt DateTime?

  /// 0-100, atualizado pelo worker durante o processamento
  progress Int @default(0)
  /// Etapa legível em andamento (ex: "Normalizando clipe 2/5")
  stage String?
  /// Mensagem de erro do último render que falhou
  errorMessage String?

  /// Key do MP4 final no storage
  outputKey      String?
  outputSizeByte Int?
  renderedAt     DateTime?

  /// --- Ambient / sons relaxantes ---
  environment       String?
  weather           String?
  timeOfDay         String?
  purpose           String?
  durationMinutes   Int?
  preset            String?
  seed              Int?
  conceptJson       Json?
  ambientConfigJson Json?
  audioTimelineJson Json?
  visualTimelineJson Json?
  qualityScore      Float?
  qualityJson       Json?
  previewKey        String?
  metadataJson      Json?

  /// Recipe versionada (Ambient)
  recipeId        String?
  recipe          Recipe? @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  recipeVersion   Int?
  pipelineVersion String?

  /// --- Rabisco ---
  /// Pensamento/desabafo original digitado pelo usuário (input bruto)
  rabiscoThought String?
  /// Roteiro gerado pelo LLM (title/hook/narration/durationTargetSec)
  rabiscoScriptJson Json?
  /// Sequência de cenas do personagem (emotion/action/position/animation/thought por trecho)
  characterScenesJson Json?
  /// Preset de duração alvo: SHORT (único suportado no MVP) | MEDIUM | LONG
  durationPreset String? @default("SHORT")
  /// Versão do prompt usado nesta geração (auditoria/A-B futura)
  rabiscoPromptVersion String?

  /// Midnight brand / packaging
  universe            String?
  variationId         String?
  seriesId            String?
  seriesEpisode       Int?
  youtubeVideoId      String?
  youtubeShortId      String?
  youtubePlaylistIds  String[] @default([])
  publishedAt         DateTime?
  parentProjectId     String?
  parentProject       Project?  @relation("AmbientShortCompanion", fields: [parentProjectId], references: [id], onDelete: SetNull)
  shortCompanions     Project[] @relation("AmbientShortCompanion")

  clips               Clip[]
  mediaAssets         MediaAsset[]
  ambientProjectAssets AmbientProjectAsset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([kind])
  @@index([status])
  @@index([userId])
  @@index([recipeId])
  @@index([universe])
  @@index([youtubeVideoId])
  @@index([verseId])
  @@index([pillar])
  @@index([scheduledAt])
}

/// Biblioteca bíblica local (módulo Canal Cristão) — nunca depender do LLM
/// para reproduzir texto de escritura, só para refletir sobre ele.
model BibleVerse {
  id          String   @id @default(cuid())
  book        String
  chapter     Int
  verse       String
  text        String
  translation String   @default("ARC")
  /// Tags temáticas para seleção contextual (ex: ["esperanca", "ansiedade"])
  themes      String[] @default([])
  firstUsedAt DateTime?
  lastUsedAt  DateTime?
  usageCount  Int      @default(0)

  projects Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([book, chapter, verse, translation])
  @@index([lastUsedAt])
}

model Clip {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Ordem de exibição, 0-based. O ranking mostrado é invertido (último = #1).
  position     Int
  originalName String
  /// Texto de contexto opcional sobrepondo o clipe
  label String?
  /// Quando true, o worker transcreve o áudio e gera legendas no render
  transcribe Boolean @default(false)
  /// Saída Whisper (segments/words) para auditoria e re-render
  transcriptJson Json?

  sourceKey String
  sizeByte  Int

  /// Duração do arquivo original, em segundos (preenchida no upload via ffprobe)
  sourceDurationSec Float?
  /// Teto de duração aplicado na normalização
  maxDurationSec Float @default(60)

  /// Preenchidos pelo worker após a normalização
  normalizedKey         String?
  normalizedDurationSec Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, position])
  @@index([projectId])
}

/// Asset de stock baixado para o pipeline Curiosidade / Ambient visual
model MediaAsset {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  provider  String
  sourceUrl String
  author    String?
  license   String?
  query     String

  localKey      String?
  durationSec   Float?
  width         Int?
  height        Int?
  /// Ordem na timeline (0-based)
  position      Int      @default(0)
  /// Trecho do roteiro associado
  scriptStartSec Float?
  scriptEndSec   Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

/// Biblioteca local de sons (módulo Ambient)
model SoundAsset {
  id           String  @id @default(cuid())
  name         String
  category     String
  subcategory  String?
  provider     String
  sourceUrl    String?
  localKey     String
  durationSec  Float
  sampleRate   Int?
  channels     Int?
  lufs         Float?
  peak         Float?
  license      String?
  licenseUrl   String?
  attribution  String?
  commercialUse         Boolean @default(false)
  modificationAllowed   Boolean @default(false)
  attributionRequired   Boolean @default(false)
  verified              Boolean @default(false)
  licenseVerdict        LicenseVerdict @default(UNKNOWN)
  tags         String[] @default([])
  qualityScore Float    @default(0)
  loopScore    Float    @default(0)

  ambientUsages AmbientProjectAsset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([licenseVerdict])
  @@index([createdAt])
}

/// Ligação entre projeto ambient e assets usados (som ou visual)
model AmbientProjectAsset {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assetId   String?
  soundAsset SoundAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  type      String
  layer     String?
  startTime Float   @default(0)
  endTime   Float?
  volume    Float   @default(1)
  metadataJson Json?

  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([assetId])
}

model Recipe {
  id          String          @id
  name        String
  description String?
  universe    String?
  pillar      String?
  seriesId    String?
  episode     Int?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  versions    RecipeVersion[]
  projects    Project[]
  /// V3: canal dono da receita (vinculado na migração)
  channelId   String?
  channel     Channel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
}

model RecipeVersion {
  id              String   @id @default(cuid())
  recipeId        String
  recipe          Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  version         Int
  definitionJson  Json
  pipelineVersion String   @default("ambient-midnight-v1")
  createdAt       DateTime @default(now())

  @@unique([recipeId, version])
  @@index([recipeId])
}

/// Canal YouTube conectado via OAuth (tokens só no servidor)
model YouTubeChannel {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channelId      String
  channelTitle   String?
  accessToken    String
  refreshToken   String
  expiresAt      DateTime?
  scope          String?
  playlistMapJson Json?
  connectedAt    DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId])
  @@index([channelId])
}

// ============================================================================
// V3 — Hub de canais e edição por IA (docs/especificacao-v3-hub-editor-ia.md)
// Modelos ADITIVOS: o legado acima permanece intacto até o corte controlado.
// ============================================================================

enum WorkspaceRole {
  OWNER
  EDITOR
  REVIEWER
}

enum SocialPlatform {
  YOUTUBE
  INSTAGRAM
  FACEBOOK
  TIKTOK
}

enum SocialAccountStatus {
  CONNECTED
  EXPIRED
  REVOKED
  ERROR
}

enum AssetKind {
  VIDEO
  AUDIO
  IMAGE
  FONT
  CHARACTER
  DOCUMENT
}

enum AssetStatus {
  UPLOADING
  UPLOADED
  ANALYZING
  READY
  FAILED
  MISSING
}

enum VideoProjectState {
  DRAFT
  EDITING
  IN_REVIEW
  APPROVED
  ARCHIVED
}

enum JobState {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCEL_REQUESTED
  CANCELLED
}

enum JobKind {
  ANALYZE
  TRANSCRIBE
  RENDER_PREVIEW
  RENDER_FINAL
  RESOLVE_EXPORT
  PUBLISH
}

enum DeliverableState {
  PENDING
  RENDERING
  VALIDATING
  READY
  FAILED
  SUPERSEDED
}

enum DeliverableKind {
  PREVIEW
  FINAL
  COVER
  CAPTIONS
  RESOLVE_PACKAGE
}

enum DeliverableOrigin {
  HUB
  EXTERNAL
  LEGACY
}

enum ApprovalDecision {
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

enum PublicationState {
  DRAFT
  APPROVED
  SCHEDULED
  UPLOADING
  PROCESSING_REMOTE
  PUBLISHED
  FAILED
  UNKNOWN
  CANCELLED
}

enum AgentRunState {
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships    Membership[]
  channels       Channel[]
  socialAccounts SocialAccount[]
  assets         Asset[]
  projects       VideoProject[]
}

model Membership {
  id          String        @id @default(cuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  role        WorkspaceRole @default(EDITOR)
  createdAt   DateTime      @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
}

/// Marca editorial: público, idiomas, tom e regras. Não é conta social nem formato.
model Channel {
  id            String    @id @default(cuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  slug          String
  name          String
  /// false = nome provisório (decisão pendente, §22)
  nameConfirmed Boolean   @default(true)
  tagline       String?
  languages     String[]  @default([])
  /// ChannelRules (packages/domain/channels.ts): tom, regras, CTAs, calendário
  rulesJson     Json
  /// Configuração de domínio (receitas, pilares, personagem)
  domainJson    Json
  linkedBrand   String?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  brandKits   BrandKitVersion[]
  series      Series[]
  templates   TemplateVersion[]
  accounts    SocialAccount[]
  projects    VideoProject[]
  characters  CharacterProfile[]
  recipes     Recipe[]
  verseUsages VerseUsage[]

  @@unique([workspaceId, slug])
}

/// Conta real numa plataforma. Credenciais cifradas; nunca vão ao agente/front.
model SocialAccount {
  id                     String              @id @default(cuid())
  workspaceId            String
  workspace              Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Associação editorial explícita (null = pendente)
  channelId              String?
  channel                Channel?            @relation(fields: [channelId], references: [id], onDelete: SetNull)
  platform               SocialPlatform
  externalId             String
  displayName            String?
  capabilitiesJson       Json?
  status                 SocialAccountStatus @default(CONNECTED)
  /// AES-256-GCM (packages/db/src/v3/crypto.ts)
  encryptedCredentials   String?
  scopes                 String[]            @default([])
  tokenExpiresAt         DateTime?
  isTestAccount          Boolean             @default(false)
  legacyYouTubeChannelId String?             @unique
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  publications Publication[]
  approvals    ReviewApproval[]

  @@unique([workspaceId, platform, externalId])
  @@index([channelId])
}

/// Identidade visual imutável usada por uma edição.
model BrandKitVersion {
  id          String   @id @default(cuid())
  channelId   String
  channel     Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  version     Int
  colorsJson  Json
  fonts       String[] @default([])
  logoAssetId String?
  stylesJson  Json?
  createdAt   DateTime @default(now())

  @@unique([channelId, version])
}

model Series {
  id         String       @id @default(cuid())
  channelId  String
  channel    Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  slug       String
  name       String
  legacyKind ProjectKind?
  configJson Json
  active     Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  projects VideoProject[]

  @@unique([channelId, slug])
}

/// Estrutura visual/narrativa versionada. Versões são imutáveis.
model TemplateVersion {
  id               String   @id @default(cuid())
  channelId        String
  channel          Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  slug             String
  version          Int
  name             String
  engine           String
  paramsSchemaJson Json
  defaultsJson     Json
  createdAt        DateTime @default(now())

  @@unique([channelId, slug, version])
}

model CharacterProfile {
  id             String   @id @default(cuid())
  channelId      String
  channel        Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  slug           String
  name           String
  profileJson    Json
  /// Arte conferida (transparência/resolução) — §3.3
  assetsVerified Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([channelId, slug])
}

/// Arquivo original imutável, identificado por hash.
model Asset {
  id             String         @id @default(cuid())
  workspaceId    String
  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  kind           AssetKind
  status         AssetStatus    @default(UPLOADING)
  /// sha256 do original
  sha256         String?
  storageKey     String
  proxyKey       String?
  originalName   String
  mimeType       String?
  sizeBytes      BigInt?
  durationSec    Float?
  width          Int?
  height         Int?
  fpsNum         Int?
  fpsDen         Int?
  hasAudio       Boolean        @default(false)
  mediaInfoJson  Json?
  provider       String?
  sourceUrl      String?
  author         String?
  license        String?
  licenseVerdict LicenseVerdict @default(UNKNOWN)
  attribution    String?
  tags           String[]       @default([])
  errorMessage   String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  usages      AssetUsage[]
  transcripts TranscriptVersion[]

  @@unique([workspaceId, sha256])
  @@index([workspaceId, kind])
}

model AssetUsage {
  id         String       @id @default(cuid())
  assetId    String
  asset      Asset        @relation(fields: [assetId], references: [id], onDelete: Restrict)
  projectId  String
  project    VideoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  revisionId String?
  createdAt  DateTime     @default(now())

  @@unique([assetId, projectId])
  @@index([projectId])
}

/// Transcrição do ORIGINAL; versões revisadas não cortam mídia.
model TranscriptVersion {
  id           String   @id @default(cuid())
  assetId      String
  asset        Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  version      Int
  language     String
  provider     String
  model        String
  cacheKey     String
  segmentsJson Json
  reviewed     Boolean  @default(false)
  reviewedById String?
  createdAt    DateTime @default(now())

  @@unique([assetId, version])
  @@index([cacheKey])
}

model VideoProject {
  id                 String            @id @default(cuid())
  workspaceId        String
  workspace          Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channelId          String
  channel            Channel           @relation(fields: [channelId], references: [id], onDelete: Restrict)
  seriesId           String?
  series             Series?           @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  title              String
  briefing           String?
  objective          String?
  targetDurationSec  Int?
  /// Formatos desejados, ex.: ["16:9","9:16"]
  formats            String[]          @default([])
  state              VideoProjectState @default(DRAFT)
  currentRevisionId  String?           @unique
  legacyKind         ProjectKind?
  legacyProjectId    String?           @unique
  legacyReadOnly     Boolean           @default(false)
  legacySnapshotJson Json?
  createdById        String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  currentRevision TimelineRevision?  @relation("CurrentRevision", fields: [currentRevisionId], references: [id])
  revisions       TimelineRevision[] @relation("ProjectRevisions")
  assetUsages     AssetUsage[]
  agentRuns       AgentRun[]
  jobs            RenderJob[]
  deliverables    Deliverable[]
  publications    Publication[]
  comments        ReviewComment[]
  verseUsages     VerseUsage[]

  @@index([workspaceId, channelId])
  @@index([state])
}

/// Versão imutável da edição (documento @editor-video/timeline).
model TimelineRevision {
  id                     String       @id @default(cuid())
  projectId              String
  project                VideoProject @relation("ProjectRevisions", fields: [projectId], references: [id], onDelete: Cascade)
  number                 Int
  parentRevisionId       String?
  schemaVersion          Int
  documentJson           Json
  /// Hash do conteúdo editorial (sem origem)
  editorialHash          String
  authorType             String
  authorUserId           String?
  agentRunId             String?
  command                String?
  summary                String?
  restoredFromRevisionId String?
  createdAt              DateTime     @default(now())

  currentOf    VideoProject? @relation("CurrentRevision")
  deliverables Deliverable[]

  @@unique([projectId, number])
  @@index([projectId, createdAt])
}

model AgentRun {
  id               String        @id @default(cuid())
  projectId        String
  project          VideoProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId           String?
  command          String
  model            String
  state            AgentRunState @default(RUNNING)
  baseRevisionId   String?
  resultRevisionId String?
  planJson         Json?
  toolCallsJson    Json?
  responseText     String?
  inputTokens      Int?
  outputTokens     Int?
  cacheReadTokens  Int?
  costUsd          Float?
  durationMs       Int?
  numTurns         Int?
  sdkVersion       String?
  sessionId        String?
  errorMessage     String?
  createdAt        DateTime      @default(now())
  finishedAt       DateTime?

  @@index([projectId, createdAt])
}

model RenderJob {
  id              String       @id @default(cuid())
  projectId       String
  project         VideoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind            JobKind
  state           JobState     @default(QUEUED)
  queue           String
  revisionId      String?
  variantId       String?
  deliverableId   String?
  assetId         String?
  paramsJson      Json?
  progress        Float        @default(0)
  stage           String?
  attempts        Int          @default(0)
  maxAttempts     Int          @default(3)
  /// Lease do worker (local ou remoto via HTTPS)
  leaseOwner      String?
  leaseExpiresAt  DateTime?
  heartbeatAt     DateTime?
  errorMessage    String?
  errorCategory   String?
  environmentJson Json?
  requestedById   String?
  idempotencyKey  String?      @unique
  createdAt       DateTime     @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?

  steps JobStep[]

  @@index([state, queue])
  @@index([projectId, createdAt])
}

/// Etapa idempotente de um job; o retry recomeça na etapa necessária.
model JobStep {
  id          String    @id @default(cuid())
  jobId       String
  job         RenderJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name        String
  cacheKey    String?
  state       JobState  @default(QUEUED)
  artifactKey String?
  outputJson  Json?
  startedAt   DateTime?
  finishedAt  DateTime?

  @@unique([jobId, name])
  @@index([cacheKey])
}

/// Cache global de artefatos por chave de etapa (hash+params+modelo+pipeline).
model ArtifactCache {
  cacheKey    String   @id
  step        String
  artifactKey String?
  outputJson  Json?
  createdAt   DateTime @default(now())
}

model Deliverable {
  id             String            @id @default(cuid())
  projectId      String
  project        VideoProject      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  revisionId     String?
  revision       TimelineRevision? @relation(fields: [revisionId], references: [id], onDelete: SetNull)
  variantId      String?
  kind           DeliverableKind
  origin         DeliverableOrigin @default(HUB)
  state          DeliverableState  @default(PENDING)
  presetVersion  String?
  storageKey     String?
  sha256         String?
  sizeBytes      BigInt?
  durationSec    Float?
  width          Int?
  height         Int?
  planHash       String?
  validationJson Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  approvals    ReviewApproval[]
  publications Publication[]

  @@index([projectId, createdAt])
}

/// Aprovação vinculada ao hash da entrega + metadados (impressão digital).
model ReviewApproval {
  id              String           @id @default(cuid())
  deliverableId   String
  deliverable     Deliverable      @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  socialAccountId String?
  socialAccount   SocialAccount?   @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  fingerprint     String
  metadataJson    Json
  decision        ApprovalDecision
  reviewerId      String
  note            String?
  revokedAt       DateTime?
  createdAt       DateTime         @default(now())

  @@index([deliverableId])
  @@index([fingerprint])
}

model ReviewComment {
  id         String       @id @default(cuid())
  projectId  String
  project    VideoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  revisionId String
  frame      Int
  authorId   String
  body       String
  resolved   Boolean      @default(false)
  createdAt  DateTime     @default(now())

  @@index([projectId, revisionId])
}

/// Distribuição de UMA entrega específica para UMA conta específica.
model Publication {
  id                  String           @id @default(cuid())
  projectId           String
  project             VideoProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deliverableId       String?
  deliverable         Deliverable?     @relation(fields: [deliverableId], references: [id], onDelete: Restrict)
  socialAccountId     String?
  socialAccount       SocialAccount?   @relation(fields: [socialAccountId], references: [id], onDelete: Restrict)
  platform            SocialPlatform
  state               PublicationState @default(DRAFT)
  /// Chave de idempotência: entrega + conta + intenção
  publicationKey      String?          @unique
  intent              String           @default("main")
  metadataJson        Json?
  approvalId          String?
  scheduledAt         DateTime?
  /// Agendamento migrado do legado, aguardando revisão
  requestedScheduleAt DateTime?
  remoteId            String?
  remoteUrl           String?
  publishedAt         DateTime?
  historical          Boolean          @default(false)
  errorMessage        String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  attempts PublicationAttempt[]

  @@index([state, scheduledAt])
  @@index([socialAccountId])
}

model PublicationAttempt {
  id                  String      @id @default(cuid())
  publicationId       String
  publication         Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  number              Int
  outcome             String
  resumableSessionUrl String?
  remoteId            String?
  bytesSent           BigInt?
  errorMessage        String?
  startedAt           DateTime    @default(now())
  finishedAt          DateTime?

  @@unique([publicationId, number])
}

/// Uso editorial de versículo por PEÇA (não por distribuição).
model VerseUsage {
  id        String       @id @default(cuid())
  verseId   String
  projectId String
  project   VideoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  channelId String
  channel   Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  usedAt    DateTime     @default(now())

  @@unique([verseId, projectId])
  @@index([channelId, usedAt])
}

model MigrationRun {
  id         String    @id @default(cuid())
  sourceRef  String
  dryRun     Boolean
  status     String
  reportJson Json?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  mappings LegacyMapping[]
}

/// Origem → destino da migração; torna a execução idempotente.
model LegacyMapping {
  id             String        @id @default(cuid())
  sourceTable    String
  sourceId       String
  targetTable    String
  targetId       String
  migrationRunId String?
  migrationRun   MigrationRun? @relation(fields: [migrationRunId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())

  @@unique([sourceTable, sourceId, targetTable])
  @@index([targetTable, targetId])
}
