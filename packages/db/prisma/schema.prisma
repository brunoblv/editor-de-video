generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectKind {
  TOP_LIST
  CURIOSIDADE
  AMBIENT
  CHRISTIAN
  RABISCO
}

enum ProjectStatus {
  DRAFT
  QUEUED
  PROCESSING
  WAITING_PREVIEW_APPROVAL
  READY
  READY_FOR_REVIEW
  PUBLISHED
  FAILED
}

enum LicenseVerdict {
  SAFE
  ATTRIBUTION_REQUIRED
  UNKNOWN
  REJECTED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  projects        Project[]
  youtubeChannel  YouTubeChannel?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id        String        @id @default(cuid())
  title     String
  watermark String?
  status    ProjectStatus @default(DRAFT)
  kind      ProjectKind   @default(TOP_LIST)

  /// Dono do projeto (nullable só para backfill de dados legados)
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Tema informado pelo usuário (pipeline Curiosidade)
  topic String?
  /// Roteiro gerado pelo LLM (JSON)
  scriptJson Json?
  /// Key do WAV de narração no storage
  voiceoverKey String?

  /// --- Canal Cristão ---
  /// Pilar de conteúdo selecionado (ex: "verse_of_day", "prayer_protection")
  pillar String?
  /// Versículo bíblico usado nesta peça (biblioteca local, nunca gerado por LLM)
  verseId String?
  bibleVerse BibleVerse? @relation(fields: [verseId], references: [id], onDelete: SetNull)
  /// Resultado do safety checker (regras de saúde/editoriais)
  safetyJson Json?
  /// Estado visual do personagem (colorLevel/lightLevel/detailLevel/emotion/pose)
  characterStateJson Json?
  /// Roteiro segmentado pelo Voice Director (emoção/ritmo/pausa por trecho) + provider usado
  voiceScriptJson Json?
  /// Horário-alvo de publicação (geração em lote) — quando setado, o worker
  /// publica automaticamente no YouTube (agendado) assim que o render terminar.
  scheduledAt DateTime?

  /// 0-100, atualizado pelo worker durante o processamento
  progress Int @default(0)
  /// Etapa legível em andamento (ex: "Normalizando clipe 2/5")
  stage String?
  /// Mensagem de erro do último render que falhou
  errorMessage String?

  /// Key do MP4 final no storage
  outputKey      String?
  outputSizeByte Int?
  renderedAt     DateTime?

  /// --- Ambient / sons relaxantes ---
  environment       String?
  weather           String?
  timeOfDay         String?
  purpose           String?
  durationMinutes   Int?
  preset            String?
  seed              Int?
  conceptJson       Json?
  ambientConfigJson Json?
  audioTimelineJson Json?
  visualTimelineJson Json?
  qualityScore      Float?
  qualityJson       Json?
  previewKey        String?
  metadataJson      Json?

  /// Recipe versionada (Ambient)
  recipeId        String?
  recipe          Recipe? @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  recipeVersion   Int?
  pipelineVersion String?

  /// --- Rabisco ---
  /// Pensamento/desabafo original digitado pelo usuário (input bruto)
  rabiscoThought String?
  /// Roteiro gerado pelo LLM (title/hook/narration/durationTargetSec)
  rabiscoScriptJson Json?
  /// Sequência de cenas do personagem (emotion/action/position/animation/thought por trecho)
  characterScenesJson Json?
  /// Preset de duração alvo: SHORT (único suportado no MVP) | MEDIUM | LONG
  durationPreset String? @default("SHORT")
  /// Versão do prompt usado nesta geração (auditoria/A-B futura)
  rabiscoPromptVersion String?

  /// Midnight brand / packaging
  universe            String?
  variationId         String?
  seriesId            String?
  seriesEpisode       Int?
  youtubeVideoId      String?
  youtubeShortId      String?
  youtubePlaylistIds  String[] @default([])
  publishedAt         DateTime?
  parentProjectId     String?
  parentProject       Project?  @relation("AmbientShortCompanion", fields: [parentProjectId], references: [id], onDelete: SetNull)
  shortCompanions     Project[] @relation("AmbientShortCompanion")

  clips               Clip[]
  mediaAssets         MediaAsset[]
  ambientProjectAssets AmbientProjectAsset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([kind])
  @@index([status])
  @@index([userId])
  @@index([recipeId])
  @@index([universe])
  @@index([youtubeVideoId])
  @@index([verseId])
  @@index([pillar])
  @@index([scheduledAt])
}

/// Biblioteca bíblica local (módulo Canal Cristão) — nunca depender do LLM
/// para reproduzir texto de escritura, só para refletir sobre ele.
model BibleVerse {
  id          String   @id @default(cuid())
  book        String
  chapter     Int
  verse       String
  text        String
  translation String   @default("ARC")
  /// Tags temáticas para seleção contextual (ex: ["esperanca", "ansiedade"])
  themes      String[] @default([])
  firstUsedAt DateTime?
  lastUsedAt  DateTime?
  usageCount  Int      @default(0)

  projects Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([book, chapter, verse, translation])
  @@index([lastUsedAt])
}

model Clip {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Ordem de exibição, 0-based. O ranking mostrado é invertido (último = #1).
  position     Int
  originalName String
  /// Texto de contexto opcional sobrepondo o clipe
  label String?
  /// Quando true, o worker transcreve o áudio e gera legendas no render
  transcribe Boolean @default(false)
  /// Saída Whisper (segments/words) para auditoria e re-render
  transcriptJson Json?

  sourceKey String
  sizeByte  Int

  /// Duração do arquivo original, em segundos (preenchida no upload via ffprobe)
  sourceDurationSec Float?
  /// Teto de duração aplicado na normalização
  maxDurationSec Float @default(60)

  /// Preenchidos pelo worker após a normalização
  normalizedKey         String?
  normalizedDurationSec Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, position])
  @@index([projectId])
}

/// Asset de stock baixado para o pipeline Curiosidade / Ambient visual
model MediaAsset {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  provider  String
  sourceUrl String
  author    String?
  license   String?
  query     String

  localKey      String?
  durationSec   Float?
  width         Int?
  height        Int?
  /// Ordem na timeline (0-based)
  position      Int      @default(0)
  /// Trecho do roteiro associado
  scriptStartSec Float?
  scriptEndSec   Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

/// Biblioteca local de sons (módulo Ambient)
model SoundAsset {
  id           String  @id @default(cuid())
  name         String
  category     String
  subcategory  String?
  provider     String
  sourceUrl    String?
  localKey     String
  durationSec  Float
  sampleRate   Int?
  channels     Int?
  lufs         Float?
  peak         Float?
  license      String?
  licenseUrl   String?
  attribution  String?
  commercialUse         Boolean @default(false)
  modificationAllowed   Boolean @default(false)
  attributionRequired   Boolean @default(false)
  verified              Boolean @default(false)
  licenseVerdict        LicenseVerdict @default(UNKNOWN)
  tags         String[] @default([])
  qualityScore Float    @default(0)
  loopScore    Float    @default(0)

  ambientUsages AmbientProjectAsset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([licenseVerdict])
  @@index([createdAt])
}

/// Ligação entre projeto ambient e assets usados (som ou visual)
model AmbientProjectAsset {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assetId   String?
  soundAsset SoundAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  type      String
  layer     String?
  startTime Float   @default(0)
  endTime   Float?
  volume    Float   @default(1)
  metadataJson Json?

  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([assetId])
}

model Recipe {
  id          String          @id
  name        String
  description String?
  universe    String?
  pillar      String?
  seriesId    String?
  episode     Int?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  versions    RecipeVersion[]
  projects    Project[]
}

model RecipeVersion {
  id              String   @id @default(cuid())
  recipeId        String
  recipe          Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  version         Int
  definitionJson  Json
  pipelineVersion String   @default("ambient-midnight-v1")
  createdAt       DateTime @default(now())

  @@unique([recipeId, version])
  @@index([recipeId])
}

/// Canal YouTube conectado via OAuth (tokens só no servidor)
model YouTubeChannel {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channelId      String
  channelTitle   String?
  accessToken    String
  refreshToken   String
  expiresAt      DateTime?
  scope          String?
  playlistMapJson Json?
  connectedAt    DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId])
  @@index([channelId])
}
