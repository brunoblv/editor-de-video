{
  "name": "editor-video",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "build:packages": "npm run build -w @editor-video/core && npm run build -w @editor-video/db",
    "db:generate": "npm run generate -w @editor-video/db",
    "db:push": "npm run push -w @editor-video/db",
    "setup": "npm run build:packages && npm run db:generate && npm run db:push",
    "dev": "concurrently -n web,worker -c cyan,magenta \"npm run dev:web\" \"npm run dev:worker\"",
    "dev:web": "npm run dev -w @editor-video/web",
    "dev:worker": "npm run dev -w @editor-video/worker",
    "studio": "npm run studio -w @editor-video/db",
    "remotion:studio": "npm run studio -w @editor-video/video",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "christian:seed-bible": "npm run christian:seed-bible -w @editor-video/worker",
    "generate:daily": "npm run christian:generate-daily -w @editor-video/worker"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  }
}
