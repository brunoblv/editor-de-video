{
  "name": "@editor-video/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "start": "dotenv -e ../../.env -- tsx src/server.ts",
    "dev": "dotenv -e ../../.env -- tsx watch src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test --test-timeout=60000 test/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.310",
    "@editor-video/core": "*",
    "@editor-video/db": "*",
    "@editor-video/domain": "*",
    "@editor-video/integrations": "*",
    "@editor-video/templates": "*",
    "@editor-video/timeline": "*",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "dotenv-cli": "^8.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
